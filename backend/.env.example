MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=scheduler

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=7

UPLOADS_DIR=uploads

FRONTEND_BASE_URL=http://localhost:5173

# Only served if this directory exists at startup - leave unset for local dev
# (Vite's own dev server handles the frontend then). In production (e.g. the
# Fly.io Docker image), this points at the built frontend copied into the image.
FRONTEND_DIST_DIR=frontend_dist

# Set to true once served over real HTTPS in production (e.g. Fly.io) so
# cookies are marked Secure. Keep false for local http:// dev.
COOKIE_SECURE=false

# Leave blank to log verification links to the console instead of sending real email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@scheduler.local

# Create a Meta Developer App (Facebook Login product) to fill these in.
# Until then, connecting will redirect to Facebook and show an app-config error.
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0
FB_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/facebook/callback

# Fernet key for encrypting stored Facebook/Instagram tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: Hugging Face token (https://huggingface.co/settings/tokens, a
# "fine-grained" token with "Make calls to Inference Providers") for AI reel
# footage - text/image-to-video clips and generated scene images. Leave blank
# and reels still work (uploaded media / plain title cards). Free accounts get
# only a tiny monthly credit, so expect 402 errors after a video or two.
HF_TOKEN=
HF_PROVIDER=auto
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_CLIPS=1
HF_SCENE_IMAGES=4
# Free route tried first: public ZeroGPU Spaces (uses your daily ZeroGPU
# minutes, not credits). Blank one to skip straight to Inference Providers.
HF_SPACE_TEXT_TO_VIDEO=Lightricks/ltx-video-distilled
HF_SPACE_IMAGE_TO_VIDEO=zerogpu-aoti/wan2-2-fp8da-aoti-faster
HF_SPACE_TEXT_TO_IMAGE=black-forest-labs/FLUX.1-schnell

# "Edit with AI" on the reel preview - any OpenAI-compatible chat API.
# Blank key = use HF_TOKEN with Hugging Face's router. Free alternative:
# Google Gemini (AI_EDIT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai,
# AI_EDIT_API_KEY=<Gemini API key>, AI_EDIT_MODEL=gemini-2.0-flash).
AI_EDIT_BASE_URL=https://router.huggingface.co/v1
AI_EDIT_API_KEY=
AI_EDIT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Reel output size (1080x1920 needs a bigger server than Fly's shared-cpu-1x).
REEL_WIDTH=720
REEL_HEIGHT=1280
